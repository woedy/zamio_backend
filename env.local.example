# Local Development Environment Variables for ZamIO Django
# Copy this to .env.local and use with docker-compose.local.yml

# Django Settings
DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings

# Security (use default for local development)
SECRET_KEY=django-insecure-wg=khcu9^_pyr8j675w94-^6bd_8g-1i#t((1=i#2zer645d9&

# Database
DATABASE_URL=postgresql://zamio_user:zamio_password@db:5432/zamio_local

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Local Development Settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,db,redis,zamio_app
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
BASE_URL=http://localhost:8001

# Email Configuration (file-based for local development)
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=sent_emails

# Optional: Configure SMTP for testing
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Zamio <your-email@gmail.com>

# AWS S3 (disabled for local development)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_FILE_OVERWRITE=False
# AWS_S3_ADDRESSING_STYLE=path
# AWS_QUERYSTRING_AUTH=False
