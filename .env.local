# Local Development Environment Variables for ZamIO Django
# Copy this to .env.local and use with docker-compose.local.yml

# Django Settings
DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings

# Security (use default for local development)
SECRET_KEY=django-insecure-wg=khcu9^_pyr8j675w94-^6bd_8g-1i#t((1=i#2zer645d9&

# Database
# If running via Docker Compose, keep the service host 'db':
# DATABASE_URL=postgresql://zamio_user:zamio_password@db:5432/zamio_local
# If running locally without Docker, either:
# 1) Remove/leave DATABASE_URL unset to use SQLite (default), or
# 2) Point to a local Postgres on localhost, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zamio

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Local Development Settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,db,redis,zamio_app,31.97.156.207
CSRF_TRUSTED_ORIGINS=http://localhost:9001,http://127.0.0.1:9001,http://31.97.156.207:9001
BASE_URL=http://localhost:9001

# Email Configuration (file-based for local development)
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=sent_emails

# Optional: Configure SMTP for testing
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Zamio <your-email@gmail.com>

# AWS S3 (disabled for local development)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_FILE_OVERWRITE=False
# AWS_S3_ADDRESSING_STYLE=path
# AWS_QUERYSTRING_AUTH=False

# ACRCloud Configuration (add your credentials here)
# ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key
# ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret
# ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
# ACRCLOUD_REGION=eu-west-1

# Audio Detection Configuration
LOCAL_CONFIDENCE_THRESHOLD=0.8
ACRCLOUD_CONFIDENCE_THRESHOLD=0.7
HYBRID_FALLBACK_ENABLED=True
MAX_RETRY_ATTEMPTS=3
PROCESSING_TIMEOUT_SECONDS=30

# PRO Integration Configuration
DEFAULT_PRO=ghamro
RECIPROCAL_AGREEMENTS_ENABLED=True
FOREIGN_PRO_RATE_PERCENTAGE=15.0
LOCAL_PRO_RATE_PERCENTAGE=10.0
